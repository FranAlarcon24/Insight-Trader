# Copia este archivo como .env (no se versiona) y completa los valores.

# --- LLM principal: API de NVIDIA (https://build.nvidia.com) ---
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# NVIDIA_THINKING=off
# NVIDIA_TIMEOUT=30
# NVIDIA_MAX_RETRIES=3

# --- Cadena de proveedores (en orden). mock = modo degradado sin LLM ---
# INSIGHT_TRADER_LLM_CHAIN=nvidia,nvidia_alt,ollama,mock
# NVIDIA_FALLBACK_MODEL=nvidia/nemotron-3.5-bolt-e4b

# --- Respaldo local con Ollama ---
# OLLAMA_HOST=http://127.0.0.1:11434
# INSIGHT_TRADER_OLLAMA_MODEL=qwen2.5:3b
# INSIGHT_TRADER_OLLAMA_TIMEOUT=180

# --- Embeddings (RAG + memoria): ollama | hash ---
# INSIGHT_TRADER_EMBEDDINGS=ollama
# INSIGHT_TRADER_EMBED_MODEL=embeddinggemma:300m

# --- Guardrail de salida: on | off ---
# INSIGHT_TRADER_GUARDRAIL=on
